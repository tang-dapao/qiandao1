# ============================================================
# D:\qiandao —— 自动签到/看广告 工程 .gitignore
# 策略：仅提交源码 + 配置，排除日志/截图/调试产物/内部目录
# ============================================================

# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/

# ---- 运行产物 / 调试噪声 ----
logs/
screenshots/
*.log

# ---- 业务状态（2026-11-09 由 logs/ 迁出）----
# 与 logs/ 的区别：这里「删了会出事故」——
#   feedback_used.txt    丢了 → 反馈内容被判重复，反馈任务全失败
#   notify_pending.jsonl 丢了 → 待补发告警永久丢失
#   notify_state.json    丢了 → 去重窗口重置，可能重复推送
# 故不入库、也不随 logs/ 一起清理；需要迁移机器时请单独备份。
state/

# ---- 调试快照 / UI dump ----
*.png
*.jpg
*.jpeg
*.gif
ui_now.xml
ui_q.xml

# ---- 本地环境 / 密钥 ----
.env
.venv/
venv/
env/
node_modules/

# ---- 本地真实账号（脱敏用：config.yaml 里是占位号，真实 QQ 号只在这里）----
accounts.local.yaml

# ---- 本地告警凭据（企业微信 corpid / agentid / secret）----
notify.local.yaml

# ---- WorkBuddy 内部目录（含项目工作记忆，非源码） ----
.workbuddy/
.jssdd/

# ---- 编辑器 / 系统 ----
.idea/
.vscode/
.DS_Store
Thumbs.db

# ---- 本地调试残留（非源码/非配置）----
_git_status.txt
_unittest_out.txt
# 抓包/下载的 apk、临时素材，与工程无关
downloads/

# ---- 巨型非源码目录（2026-11-10 上传前排除，合计约 3 GB）----
# 三者都不是本仓库的源码，且体积远超 GitHub 单文件 100 MB 限制：
#   _archive/            947 MB  目录重组前的 zip 归档（downloads/legacy/logs/screenshots）
#   robot/               738 MB  NapCat QQ 机器人框架（12054 个文件，含 Node 运行时 zip）
#   robote2--onlytalk/   1.4 GB  另一个机器人项目（27864 个文件）
# 需要迁移时请单独打包同步，不要走 git。
_archive/
robot/
robote2--onlytalk/
